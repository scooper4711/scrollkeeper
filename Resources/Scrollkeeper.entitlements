<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Signing in to paizo.com, the downloads, cover art and the update check. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- A download folder the user chooses, and the Finder tags on its files. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- The bookmark that reaches the chosen folder again after a restart (ChosenDownloadFolder). -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <!-- The updater saves the new version's disk image in Downloads. -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
    <!-- The download folder shared with the other Tableside Toolkit apps. scripts/build-app.sh puts the signing
         team's ID in place of TEAM_ID, and leaves the group out of an ad hoc build. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>TEAM_ID.io.github.scooper4711.tableside</string>
    </array>
</dict>
</plist>
